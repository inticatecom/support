generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * The base user, represents an account or user. Created when a user creates an account.
 */
model User {
  id String @id @unique @default(cuid())

  // User Information
  name     String?
  username String? @unique
  email    String? @unique
  image    String?

  // Account Data
  emailVerified DateTime?
  password      String?
  accounts      Account[]
  sessions      Session[]

  // WebAuthn Support
  Authenticator Authenticator[]

  // Time Data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Application Data
  ownedOrganizations Organization[]
  organizations      Organization[] @relation(name: "Agents")
}

/**
 * Represents an organization.
 */
model Organization {
  id String @id @unique @default(cuid())

  // Organization Information
  name    String @unique
  summary String @db.Text
  apiKey  String @unique @default(uuid())

  // Organization Owner
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  agents User[] @relation(name: "Agents") // Members of the Organization

  // Optional Data Fields (used for statistics)
  useCase   String? @db.Text
  employees Int?
  userBase  Int?

  // Time Data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Represents an OAuth provider connected to a user.
 */
model Account {
  id                       String  @id @unique @default(cuid())
  userId                   String  @unique
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/**
 * A database session, only used when the session strategy is set to 'database'.
 */
model Session {
  id           String   @id @unique @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * A verification token used for verifying a user's account.
 */
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * Support for WebAuthn.
 */
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

/**
 * The role for a user.
 */
enum Role {
  AGENT
  ADMIN
  OWNER
}
